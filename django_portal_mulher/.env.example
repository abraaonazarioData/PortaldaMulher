# Exemplo de variáveis de ambiente para Produção / Homologação
# Copie este arquivo para .env e configure os valores adequados

# Chave secreta de produção (gere uma chave forte aleatória com secrets.token_urlsafe(50))
DJANGO_SECRET_KEY=substitua-por-uma-chave-secreta-longa-e-aleatoria

# Modo de depuração (False em produção)
DJANGO_DEBUG=False

# Domínios e IPs autorizados a acessar o portal (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mulher.mt.gov.br

# Forçar SSL e políticas estritas de HTTPS (True em produção)
DJANGO_PRODUCTION=True

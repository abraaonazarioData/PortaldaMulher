[Unit]
Description=Gunicorn daemon para Portal Mulher MT
After=network.target

[Service]
User=abraaonazario
Group=abraaonazario
WorkingDirectory=/home/abraaonazario/Portal-Mulher-main/django_portal_mulher
Environment="PATH=/home/abraaonazario/Portal-Mulher-main/django_portal_mulher/.venv/bin"
Environment="DJANGO_DEBUG=False"
Environment="DJANGO_PRODUCTION=True"
Environment="DJANGO_ALLOWED_HOSTS=*,192.168.171.79,172.16.101.21,localhost,127.0.0.1,mulher.mt.gov.br"
Environment="CSRF_TRUSTED_ORIGINS=http://192.168.171.79,http://192.168.171.79:80,http://192.168.171.79:8000,http://172.16.101.21,http://172.16.101.21:80,http://172.16.101.21:8000,https://mulher.mt.gov.br,http://*.mt.gov.br,https://*.mt.gov.br"
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/home/abraaonazario/Portal-Mulher-main/django_portal_mulher/.venv/bin/gunicorn \
    --workers 3 \
    --threads 4 \
    --bind 0.0.0.0:80 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    portal_django.wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

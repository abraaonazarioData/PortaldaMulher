# ============================================================================
# Variáveis de Ambiente para Docker — Portal Mulher MT
# Copie este arquivo para .env.docker e preencha com valores reais
# ============================================================================

# Chave secreta Django (Gere uma chave longa e única em produção)
# Exemplo para gerar no terminal: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=sua_chave_secreta_super_segura_aqui_substitua_em_producao

# Modo de operação (Mantenha False em produção)
DJANGO_DEBUG=False
DJANGO_PRODUCTION=True

# Hosts autorizados (separados por vírgula)
# No Windows/Local: localhost,127.0.0.1
# No Linux/Produção: mulher.mt.gov.br,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mulher.mt.gov.br

# Origens confiáveis para CSRF (requisições de formulários e painel admin)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://mulher.mt.gov.br

# Porta de exposição no host (Padrão: 8000)
PORTAL_PORT=8000
